# S3 Credentials for the rclone S3 gateway
# IMPORTANT: Use strong, randomly generated credentials.

# The S3 Access Key ID clients use to authenticate against the bridge.
S3_ACCESS_KEY_ID=YOUR_S3_ACCESS_KEY_ID

# The S3 Secret Access Key clients use to authenticate against the bridge.
S3_SECRET_ACCESS_KEY=YOUR_S3_SECRET_ACCESS_KEY

# Authenticate INCOMING requests to the rclone `serve s3` endpoint.
# This is what protects the bridge — without it the endpoint is anonymous.
# rclone reads RCLONE_AUTH_KEY as the `--auth-key` flag, formatted
# as "ACCESS_KEY_ID,SECRET_ACCESS_KEY".
RCLONE_AUTH_KEY=${S3_ACCESS_KEY_ID},${S3_SECRET_ACCESS_KEY}

# The RCLONE_S3_* variables below configure any `type = s3` UPSTREAM backend
# (see rclone.conf.example). They do NOT protect incoming requests — use
# RCLONE_AUTH_KEY above for that.
RCLONE_S3_ACCESS_KEY_ID=${S3_ACCESS_KEY_ID}
RCLONE_S3_SECRET_ACCESS_KEY=${S3_SECRET_ACCESS_KEY}
